#!/usr/bin/env python3
"""Launcher for AuraForge.

Works from a source checkout and from the installed copy in
/opt/auraforge (symlinked to /usr/local/bin): the package directory is
always found next to the real location of this script.
"""
import os
import sys

APP_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir)
sys.path.insert(0, os.path.abspath(APP_DIR))

from auraforge.application import main  # noqa: E402

sys.exit(main())
